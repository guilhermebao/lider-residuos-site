# Para a hospedagem do cliente (Apache/cPanel). A Vercel ignora este arquivo.
Options -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Força HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Remove barra final (/pagina/ -> /pagina), igual à Vercel
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)/$ /$1 [L,R=301]

# /pagina -> /pagina/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ /$1/index.html [L]

# Redirecionamentos 301 das páginas antigas (preencher após o levantamento no Search Console)
# Redirect 301 /pagina-antiga /empresa-coleta-residuos-industriais

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
</IfModule>
