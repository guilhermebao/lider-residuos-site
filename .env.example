# URL pública usada em canonical, schema e sitemap
VITE_SITE_URL=https://www.liderresiduos.com.br

# Chave do Web3Forms (https://web3forms.com) — os formulários chegam no e-mail cadastrado nela.
# Sem a chave, o envio abre o WhatsApp com os dados preenchidos.
VITE_WEB3FORMS_KEY=

# true na Vercel de apresentação para o Google não indexar a prévia
VITE_NOINDEX=false
